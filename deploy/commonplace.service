# systemd user unit for the commonplace tailnet HTTP server (Linux).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/commonplace.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now commonplace
#   loginctl enable-linger $USER   # keep it running when logged out
#
# Adjust COMMONPLACE_REPO below if your path differs. The database lives at
# ~/.local/share/commonplace/memory.db unless COMMONPLACE_DB is set.

[Unit]
Description=commonplace shared agent memory (MCP over HTTP on the tailnet)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Environment=COMMONPLACE_REPO=%h/Documents/git/commonplace
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh ${COMMONPLACE_REPO}/deploy/commonplace-tailnet.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
